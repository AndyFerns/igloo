# ── LLM provider (OpenAI-compatible Chat Completions API) ─────────────────
# Works with any OpenAI-compatible endpoint: OpenAI, OpenRouter, Together,
# Groq, a local vLLM/Ollama server, etc. Only the three vars below change.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Retrieval (RAG over the SIH problem-statement corpus) ─────────────────
# The prototype ships a pure-TypeScript TF-IDF retriever that needs no
# external service. EMBEDDING_MODEL / FAISS_INDEX_PATH are read by the
# retrieval service as the documented extension point for a future
# embedding + FAISS backend.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/faiss/index
SIH_DATA_PATH=./data/sih2026_problem_statements.json

# ── Frontend ──────────────────────────────────────────────────────────────
# Leave empty to call the built-in Next.js API routes on the same origin.
NEXT_PUBLIC_API_URL=
